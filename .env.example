# Copy this file to .env.local for local development.
# Production should replace these with the external workers.dev origin.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,contextboard://auth-complete

# VPS-only values. Never expose these through Vite public environment variables.
CONTEXTBOARD_DATA_DIR=./.data
HOST=127.0.0.1
PORT=8788
# Optional Web Worker direct upstream for local development. When set, it wins
# over the VPC binding. Never set this in production.
SYNC_VPS_URL=http://127.0.0.1:8788
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=

# Browser uses same-origin /api/sync and does not need the private VPS address.
VITE_SYNC_ENABLED=false
