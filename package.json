{
  "name": "contextboard",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@contextboard/web --filter=@contextboard/sync-server --filter=@contextboard/desktop",
    "dev:web": "turbo run dev --filter=@contextboard/web --filter=@contextboard/sync-server",
    "dev:sync": "turbo run dev --filter=@contextboard/sync-server",
    "dev:desktop": "turbo run dev --filter=@contextboard/desktop --filter=@contextboard/sync-server",
    "dev:agent-server": "bun run --filter @contextboard/agent-server dev",
    "build:desktop": "bun tools/build-desktop.ts",
    "test:desktop": "bun run --filter @contextboard/desktop test && bun run --filter @contextboard/desktop rust:test",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "bun run --filter @contextboard/web-sync-e2e test:e2e",
    "test:browser": "bun run --filter @contextboard/web test:browser",
    "test:browser:headed": "bun run test:browser -- --headed",
    "test:browser:ui": "bun run test:browser -- --ui",
    "test:browser:debug": "bun run test:browser -- --debug",
    "test:browser:report": "bunx playwright show-report apps/web/playwright-report",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "deploy": "turbo run deploy --filter=@contextboard/web",
    "generate-routes": "turbo run generate-routes --filter=@contextboard/web",
    "export:convex": "bun run --filter @contextboard/convex-export export"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "turbo": "^2.5.8",
    "typescript": "^6.0.2"
  }
}
