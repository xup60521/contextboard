# Sync service configuration. Copy to .env.local for development and
# .env.production for the VPS. Both are gitignored.
#
# This service owns Better Auth and the change log, so every secret in the
# system lives here and nowhere else. The Cloudflare Worker holds no secrets:
# its bindings are declared in apps/web/wrangler.jsonc. The desktop shell only
# needs a public URL, in apps/desktop/.env.example.

# Public origin the auth handler builds callback URLs against. This is the Web
# origin that proxies to this service, not this service's own address.
BETTER_AUTH_URL=http://localhost:3000

# Origins allowed to complete auth flows. Include the desktop app: Better Auth
# rejects cross-origin state-changing requests from untrusted origins.
# Development uses the Vite dev origin; a packaged Windows build is served from
# http://tauri.localhost.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:1420

# Origins allowed to call /api/auth and /api/sync cross-origin. Only the desktop
# shell needs this; the Web client is same-origin behind the Worker. Leave empty
# to keep this service same-origin only.
CONTEXTBOARD_DESKTOP_ORIGINS=http://localhost:1420

# Exact, case-insensitive emails allowed to use the deployed workspace.
# GitHub must report the email as verified. Changes require a service restart.
CONTEXTBOARD_ALLOWED_EMAILS=you@example.com

# SQLite databases and content-addressed blobs.
CONTEXTBOARD_DATA_DIR=./.data
HOST=127.0.0.1
PORT=8788

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=
