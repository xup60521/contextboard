# Desktop shell configuration. Copy to .env.local; it is gitignored.
#
# Vite inlines this at build time, so it must never hold a secret and must never
# point at the private VPS address. Auth and sync are both served by the sync
# service; this is the public edge that proxies to it.
#
# Development: the Web app on http://localhost:3000 (so `bun run dev`, not
# `bun run dev:desktop`, since GitHub's OAuth callback resolves against
# BETTER_AUTH_URL).
# Production: the Cloudflare Worker origin. Add that same origin to `connect-src`
# in src-tauri/tauri.conf.json, or a packaged build will block every request.
VITE_CONTEXTBOARD_SYNC_URL=http://localhost:3000
