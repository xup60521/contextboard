{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Contextboard",
  "version": "0.0.0",
  "identifier": "app.contextboard.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "title": "Contextboard",
        "width": 1240,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
