{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "contextboard",
  "main": "./src/server.ts",
  "compatibility_date": "2026-06-30", // don't change this unless you know what you're doing
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "upload_source_maps": true,
  "ratelimits": [
    {
      "name": "SYNC_RATE_LIMIT",
      "namespace_id": "41001",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "BLOB_RATE_LIMIT",
      "namespace_id": "41002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "env": {
    "dev": {
      "vars": {
        // Local development has no VPC tunnel connector. Override this in
        // .env.local when the Bun sync server uses another address.
        "SYNC_VPS_URL": "http://127.0.0.1:8789"
      },
      "ratelimits": [
        {
          "name": "SYNC_RATE_LIMIT",
          "namespace_id": "41001",
          "simple": {
            "limit": 600,
            "period": 60
          }
        },
        {
          "name": "BLOB_RATE_LIMIT",
          "namespace_id": "41002",
          "simple": {
            "limit": 120,
            "period": 60
          }
        }
      ]
    }
  },
  "vpc_services": [{
    "binding": "SYNC_VPS",
    "service_id": "019fa942-f01d-7f82-81ad-f11d3d95a1a0",
    "remote": true
  }]
}
